# ---- Python ----
__pycache__/
scripts/**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---- Virtual environments ----
.venv/
.venv-linux/
venv/
env/

# ---- Secrets (NEVER commit) ----
.env
*.key
*.pem

# ---- Runtime state (regenerated on every deploy) ----
state/
logs/
reports/*.csv
reports/*.log
reports/*.png
reports/*.json
reports/.dir_cache/
reports/.dir_cache*/
reports/.screener_cache/
nohup.out

# ---- Archives / editor junk ----
hlbot.tar.gz
*.tar.gz
*.bak
*.tmp
*.bak-*
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
hlbot-status.sh

# ---- Allow .gitkeep placeholders through ----
!state/.gitkeep
!logs/.gitkeep
!reports/.gitkeep
reports/.trend_cache/
reports/.funding_decile_cache/
reports/.q5_cache/
reports/.binance_cache/
reports/.macd_cache/
reports/.orderflow_cache/
reports/.entry_ds_cache/
reports/.entry_quality_cache/
reports/.ifvg_cache/
reports/.overshoot_cache/

# Webull OpenAPI credentials - never commit an App Secret
webull_credentials*.json
**/webull/credentials.json

# Webull SDK runtime log
webull_data_sdk.log
webull_sdk*.log
reports/.webull_cache/
