# ---- Python ----
__pycache__/
scripts/**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---- Virtual environments ----
.venv/
.venv-linux/
venv/
env/

# ---- Secrets (NEVER commit) ----
.env
*.key
*.pem

# ---- Runtime state (regenerated on every deploy) ----
state/
logs/
reports/*.csv
reports/*.log
reports/*.png
reports/*.json
reports/.dir_cache/
reports/.dir_cache*/
reports/.screener_cache/
nohup.out

# ---- Archives / editor junk ----
hlbot.tar.gz
*.tar.gz
*.bak
*.tmp
*.bak-*
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
hlbot-status.sh

# ---- Allow .gitkeep placeholders through ----
!state/.gitkeep
!logs/.gitkeep
!reports/.gitkeep
