[Unit]
Description=Local web view for Hyperliquid research dashboards
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/hlbot/hyperliquid-stat-arb-bot/reports
ExecStart=/home/hlbot/hyperliquid-stat-arb-bot/.venv/bin/python -m http.server 8765 --bind 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
